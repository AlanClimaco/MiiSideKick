; ===================================================================
; MiiSideKick - NSIS Language File: English (US)
; ===================================================================

; Welcome & Finish Pages
LangString welcome_title ${LANG_ENGLISH} "Welcome to the MiiSideKick Setup Wizard"
LangString welcome_text ${LANG_ENGLISH} "This wizard will guide you through installing MiiSideKick on your computer.$\r$\n$\r$\nMiiSideKick is your desktop companion powered by artificial intelligence, proactive maintenance alerts, and Frutiger Aero / Nintendo Wii style interactive notifications.$\r$\n$\r$\nClick Next to continue."
LangString finish_title ${LANG_ENGLISH} "Installation Completed Successfully!"
LangString finish_text ${LANG_ENGLISH} "MiiSideKick has been installed on your computer.$\r$\n$\r$\nThe assistant will stay active in your System Tray. You can press Ctrl + Shift + M at any time to talk to Mii!$\r$\n$\r$\nClick Finish to complete setup."

; Transparency & Permissions
LangString transparency_header_title ${LANG_ENGLISH} "System Transparency & Permissions"
LangString transparency_header_subtitle ${LANG_ENGLISH} "Details on AI usage, shortcuts, RAM monitoring, and privacy"
LangString transparency_top ${LANG_ENGLISH} "Please review how MiiSideKick operates on your computer before proceeding:"
LangString transparency_checkbox ${LANG_ENGLISH} "I have read and agree to the transparency terms and system permissions."

; Uninstaller
LangString un_welcome_title ${LANG_ENGLISH} "MiiSideKick Uninstall Wizard"
LangString un_welcome_text ${LANG_ENGLISH} "This wizard will completely remove MiiSideKick from your computer.$\r$\n$\r$\nWe will miss you! Click Next to continue with uninstallation."
LangString deleteAppData ${LANG_ENGLISH} "Also remove local application data and API key (%APPDATA%\MiiSideKick)"
LangString un_finish_title ${LANG_ENGLISH} "Uninstallation Complete"
LangString un_finish_text ${LANG_ENGLISH} "MiiSideKick has been successfully removed from your system."

; Operational installer messages (Tauri compatible)
LangString addOrReinstall ${LANG_ENGLISH} "Add/Reinstall components"
LangString alreadyInstalled ${LANG_ENGLISH} "Already Installed"
LangString alreadyInstalledLong ${LANG_ENGLISH} "${PRODUCTNAME} ${VERSION} is already installed. Select the operation you want to perform and click Next to continue."
LangString appRunning ${LANG_ENGLISH} "MiiSideKick is currently running! Please close it from the system tray and try again."
LangString appRunningOkKill ${LANG_ENGLISH} "MiiSideKick is running in the background!$\r$\nClick OK to close it automatically."
LangString chooseMaintenanceOption ${LANG_ENGLISH} "Choose the maintenance option to perform."
LangString chooseHowToInstall ${LANG_ENGLISH} "Choose how you want to install ${PRODUCTNAME}."
LangString createDesktop ${LANG_ENGLISH} "Create desktop shortcut"
LangString dontUninstall ${LANG_ENGLISH} "Do not uninstall"
LangString dontUninstallDowngrade ${LANG_ENGLISH} "Do not uninstall (Downgrading without uninstall is disabled for this installer)"
LangString failedToKillApp ${LANG_ENGLISH} "Failed to close MiiSideKick automatically. Please exit the app manually first."
LangString installingWebview2 ${LANG_ENGLISH} "Installing Microsoft Edge WebView2 component..."
LangString newerVersionInstalled ${LANG_ENGLISH} "A newer version of ${PRODUCTNAME} is already installed! It is recommended to keep the current version."
LangString olderOrUnknownVersionInstalled ${LANG_ENGLISH} "An older version of ${PRODUCTNAME} was detected. Would you like to update it now?"
LangString unableToUninstall ${LANG_ENGLISH} "Unable to uninstall the existing version."
LangString webview2AbortError ${LANG_ENGLISH} "Failed to install WebView2. MiiSideKick requires it to render the interface."

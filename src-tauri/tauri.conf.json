{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiiSideKick",
  "version": "1.6.0",
  "identifier": "com.alã.assistente",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MiiSideKick",
        "width": 490,
        "height": 590,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/uninstall.ico",
        "sidebarImage": "icons/nsis-sidebar-install.bmp",
        "headerImage": "icons/nsis-header-install.bmp",
        "uninstallerHeaderImage": "icons/nsis-header-uninstall.bmp",
        "customLanguageFiles": {
          "PortugueseBR": "windows/nsis/languages/PortugueseBR.nsh",
          "English": "windows/nsis/languages/English.nsh"
        },
        "installerHooks": "windows/installer.nsh",
        "template": "windows/installer.nsi"
      }
    }
  }
}
